      <table>
        <view>
          <datasources>
            <datasource caption='sample_-_superstore (1)' name='federated.1lr7fwa1ghy45a124yip91v0cftn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Year Seleceted' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
            <column alias='PROFIT' caption='Metric Swap Param' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Profit&quot;'>
              <calculation class='tableau' formula='&quot;Profit&quot;' />
              <aliases>
                <alias key='&quot;Orders&quot;' value='ORDERS' />
                <alias key='&quot;Profit&quot;' value='PROFIT' />
                <alias key='&quot;Sales&quot;' value='SALES' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1lr7fwa1ghy45a124yip91v0cftn'>
            <column caption='Sales Selected Year' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_1645552504905728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If YEAR([Order Date])= [Parameters].[Parameter 1]&#10;Then [Sales]&#10;END' />
            </column>
            <column caption='Selected Year ' datatype='integer' default-format='n0;-0' name='[Calculation_1645552507318277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Metric Swap Caluc' datatype='real' name='[Calculation_1645552877109275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Sales&quot; then ZN(SUM([Calculation_1645552504905728]))&#10;WHEN &quot;Profit&quot; then ZN(SUM([Sales Selected Year (copy)_1645552580079624]))&#10;WHEN &quot;Orders&quot; then ZN(COUNTD([Profit Selected Year  (copy)_1645552581623822]))&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Metric Swap Caluc PY (Label) ' datatype='string' name='[Metric Swap Caluc (Label) (copy)_1645552879087645]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Sales&quot; then &quot;$&quot;+ STR(ROUND(SUM([Sales Selected Year (copy)_1645552505704449])/1000,1))+&quot;K&quot;&#10;WHEN &quot;Profit&quot; then &quot;$&quot;+ STR(ROUND(SUM([Sales Previous Year (copy)_1645552580186121])/1000,1))+&quot;K&quot;&#10;WHEN &quot;Orders&quot; then STR(COUNT([Profit Previous Year (copy)_1645552581345293]))&#10;END' />
            </column>
            <column caption='Metric Swap Caluc (Label)' datatype='string' name='[Metric Swap Caluc (copy)_1645552878321692]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Sales&quot; then &quot;$&quot;+ STR(ROUND(SUM([Calculation_1645552504905728])/1000,1))+&quot;K&quot;&#10;WHEN &quot;Profit&quot; then &quot;$&quot;+ STR(ROUND(SUM([Sales Selected Year (copy)_1645552580079624])/1000,1))+&quot;K&quot;&#10;WHEN &quot;Orders&quot; then STR(COUNT([Profit Selected Year  (copy)_1645552581623822]))&#10;END' />
            </column>
            <column caption='Metric Swap Caluc PY' datatype='real' name='[Metric Swap Caluc (copy)_1645552879271966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Sales&quot; then ZN(SUM([Sales Selected Year (copy)_1645552505704449]))&#10;WHEN &quot;Profit&quot; then ZN(SUM([Sales Previous Year (copy)_1645552580186121]))&#10;WHEN &quot;Orders&quot; then ZN(COUNT([Profit Previous Year (copy)_1645552581345293]))&#10;END' />
            </column>
            <column caption='Metric Swap Change YoY' datatype='real' default-format='p0.0%' name='[Metric Swap Caluc (copy)_1645552880738335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &quot;Sales&quot; THEN&#10;IF ZN(SUM([Sales Selected Year (copy)_1645552505704449])) = 0 THEN 0&#10;ELSE&#10;(SUM([Calculation_1645552504905728]) - SUM([Sales Selected Year (copy)_1645552505704449]))&#10;/ SUM([Sales Selected Year (copy)_1645552505704449])&#10;END&#10;&#10;WHEN &quot;Profit&quot; THEN&#10;IF zn(SUM([Sales Previous Year (copy)_1645552580186121])) = 0 THEN 0&#10;ELSE&#10;(SUM([Sales Selected Year (copy)_1645552580079624]) - SUM([Sales Previous Year (copy)_1645552580186121]))&#10;/ SUM([Sales Previous Year (copy)_1645552580186121])&#10;END&#10;&#10;WHEN &quot;Orders&quot; THEN&#10;IF zn(COUNT([Profit Previous Year (copy)_1645552581345293])) = 0 THEN 0&#10;ELSE&#10;(COUNT([Profit Selected Year  (copy)_1645552581623822]) - COUNT([Profit Previous Year (copy)_1645552581345293]))&#10;/ COUNT([Profit Previous Year (copy)_1645552581345293])&#10;END&#10;&#10;END' />
            </column>
            <column caption='Metric Swap Change YoY Sign' datatype='real' default-format='*⬆︎;⬇︎' name='[Metric Swap Change YoY (copy)_1645552881643552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Sales&quot; then (SUM([Calculation_1645552504905728])-SUM([Sales Selected Year (copy)_1645552505704449]))/SUM([Sales Selected Year (copy)_1645552505704449])&#10;WHEN &quot;Profit&quot; then (SUM([Sales Selected Year (copy)_1645552580079624])-SUM([Sales Previous Year (copy)_1645552580186121]))/SUM([Sales Previous Year (copy)_1645552580186121])&#10;WHEN &quot;Orders&quot; then (COUNT([Profit Selected Year  (copy)_1645552581623822])-COUNT([Profit Previous Year (copy)_1645552581345293]))/COUNT([Profit Previous Year (copy)_1645552581345293])&#10;END' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
            <column caption='Order Previous Year ' datatype='string' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Profit Previous Year (copy)_1645552581345293]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If YEAR([Order Date])= [Parameters].[Parameter 1]-1&#10;Then [Order ID]&#10;END' />
            </column>
            <column caption='Order Selected Year  ' datatype='string' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Profit Selected Year  (copy)_1645552581623822]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If YEAR([Order Date])= [Parameters].[Parameter 1]&#10;Then [Order ID]&#10;END' />
            </column>
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column caption='Profit Previous Year' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Sales Previous Year (copy)_1645552580186121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If YEAR([Order Date])= [Parameters].[Parameter 1]-1&#10;Then [Profit]&#10;END' />
            </column>
            <column caption='Sales Previous Year' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Sales Selected Year (copy)_1645552505704449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If YEAR([Order Date])= [Parameters].[Parameter 1]-1&#10;Then [Sales]&#10;END' />
            </column>
            <column caption='Profit Selected Year ' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Sales Selected Year (copy)_1645552580079624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If YEAR([Order Date])= [Parameters].[Parameter 1]&#10;Then [Profit]&#10;END' />
            </column>
            <column aggregation='Sum' datatype='real' default-format='c&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Sales]' role='dimension' type='ordinal' />
            <column caption='Previous Selected Year' datatype='integer' default-format='n0;-0' name='[Selected Year  (copy)_1645552507617286]' role='measure' type='quantitative'>
