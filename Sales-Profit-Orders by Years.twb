            <column-instance column='[Metric Swap Caluc (copy)_1645552878321692]' derivation='User' name='[usr:Metric Swap Caluc (copy)_1645552878321692:nk]' pivot='key' type='nominal' />
            <column-instance column='[Metric Swap Caluc (copy)_1645552879271966]' derivation='User' name='[usr:Metric Swap Caluc (copy)_1645552879271966:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Metric Swap Caluc (copy)_1645552880738335]' derivation='User' name='[usr:Metric Swap Caluc (copy)_1645552880738335:ok]' pivot='key' type='ordinal' />
